# Copy this file to .env and fill values for local development
# IMPORTANT: Do NOT commit your real API keys. Rotate any keys you accidentally committed.

# OpenAI API key (example):
# OPENAI_API_KEY=sk-...

# Path to sqlite DB (optional override)
# DB_PATH=data/invoices.db

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# --- Phase 4: Parsing Configuration ---

# Minimum amount in EUR to include in invoices (filter out small items)
# Default: 128.0
# PARSING_MIN_AMOUNT=128.0

# Quantity tolerance for service matching (as decimal, e.g., 0.5 = 50% tolerance)
# Default: 0.5
# PARSING_QUANTITY_TOLERANCE=0.5

# Maximum tokens per OpenAI API call (conservative limit to stay under model limits)
# Default: 6000 (safe limit for gpt-4-mini with 128K context)
# PARSING_MAX_TOKENS_PER_CALL=6000

